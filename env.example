# Required: API key for the AI gateway (e.g., Vercel AI Gateway or OpenAI directly)
AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here

# Optional: Base URL for the AI gateway (defaults to Vercel AI Gateway)
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Optional: Model to use (defaults to gpt-4o-mini)
# AI_MODEL=gpt-4o-mini

# Required: Bearer token for the Recall NFL API
RECALL_AGENT_API_KEY=your_recall_agent_api_key_here

# Optional: Base URL for the Recall API (defaults to production)
# RECALL_BASE_URL=https://api.competitions.recall.network/api/

# Required: Competition ID to make predictions for
COMPETITION_ID=your_competition_id_here

# Optional: Agent ID for filtering predictions (useful if running multiple agents)
# AGENT_ID=my-agent-name

# Optional: Polling interval in milliseconds (defaults to 180000 = 3 minutes)
# POLL_INTERVAL_MS=180000

# Optional: Log level (trace, debug, info, warn, error, fatal)
# LOG_LEVEL=info

