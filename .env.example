# Recall agent & competition settings
RECALL_AGENT_API_KEY=your_recall_api_key
AGENT_ID=your_recall_agent_id
COMPETITION_ID=recall_competition_id

# AI provider settings
AI_GATEWAY_API_KEY=your_vercel_api_key
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1 # Optional (defaults to Vercel's AI gateway)
AI_MODEL=openai/gpt-4o-mini # Defaults to 4o-mini. See Vercel AI SDK docs for full list: https://vercel.com/ai-gateway/models